generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  username        String  @unique
  email           String  @unique
  pendingNewEmail String? @map("pending_new_email")
  password        String
  tokens          Token[]

  notifications         Notifications[]
  notificationsSettings NotificationsSettings?
  loyaltyCard           LoyaltyCard?

  isVerified      Boolean   @default(false) @map("is_verified")
  isEmailVerified Boolean   @default(false) @map("is_email_verified")
  isTotpEnabled   Boolean   @default(false) @map("is_totp_enabled")
  totpSecret      String?   @map("totp_secret")
  isDeactivated   Boolean   @default(false) @map("is_deactivated")
  deactivatedAt   DateTime? @map("deactivated_at")
  accounts        Account[]

  fcmTokens       DeviceToken[]
  articleComments ArticleComment[]

  phoneNumber String? @unique @map("phone_number")

  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id         String @id @default(uuid())
  provider   String
  providerId String @map("provider_id")
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerId])
  @@map("accounts")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String
  description String?
  imageUrl    String?    @map("image_url")
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("category_tree", fields: [parentId], references: [id])
  children    Category[] @relation("category_tree")
  products    Product[]

  rostaId String? @unique @map("rosta_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String?
  description String?
  price       Decimal? @db.Decimal(12, 2)
  stock       Int      @default(0)
  isPublished Boolean  @default(false) @map("is_published")
  isDraft     Boolean  @default(true) @map("is_draft")

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?   @map("category_id")

  attributes      Json? // { "color": "red", "size": "XL" }
  discountPercent Int?  @default(0) @map("discount_percent") // 0–100, скидка на товар
  avgRating       Float @default(0) @map("avg_rating")
  reviewCount     Int   @default(0) @map("review_count")

  rostaId String? @unique @map("rosta_id")

  cartItems  CartItem[]
  orderItems OrderItem[]
  variants   ProductVariant[]
  reviews    Review[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  medias    Media[]

  @@index([categoryId])
  @@index([isPublished])
  @@map("products")
}

model Post {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  excerpt     String?
  body        String
  coverImage  String?   @map("cover_image")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  tags        String[]

  comments ArticleComment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isPublished])
  @@map("posts")
}

model ArticleComment {
  id     String @id @default(uuid())
  body   String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String @map("post_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([postId])
  @@map("article_comments")
}

model Cart {
  id     String     @id @default(uuid())
  userId String     @unique @map("user_id")
  items  CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id         String  @id @default(uuid())
  cart       Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId     String  @map("cart_id")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String  @map("product_id")
  quantity   Int     @default(1)
  isSelected Boolean @default(true) @map("is_selected")

  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?         @map("variant_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Order {
  id     String      @id @default(uuid())
  userId String      @map("user_id")
  status OrderStatus @default(PROCESSING)

  items    OrderItem[]
  payment  Payment?
  shipping ShippingAddress?

  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal? @map("discount_amount") @db.Decimal(12, 2)
  note           String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String  @map("order_id")
  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")

  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId   String?         @map("variant_id")
  variantName String?         @map("variant_name") // snapshot

  quantity     Int
  priceAtOrder Decimal @map("price_at_order") @db.Decimal(12, 2) // snapshot цены на момент заказа

  @@map("order_items")
}

model ShippingAddress {
  id      String @id @default(uuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique @map("order_id")

  fullName     String       @map("full_name")
  phone        String
  city         String
  street       String
  building     String
  apartment    String?
  postalCode   String?      @map("postal_code")
  deliveryType DeliveryType @default(COURIER) @map("delivery_type")

  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  branchId String? @map("branch_id")

  @@map("shipping_addresses")
}

model Media {
  id String @id @default(uuid())

  url       String
  mediaType MediaType @default(IMAGE)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String    @map("product_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("medias")
}

// ─── ПЛАТЕЖИ (Kaspi + Halyk Ekvayring) ───────────────────────────────────────

model Payment {
  id      String @id @default(uuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @unique @map("order_id")

  method   PaymentMethod  @map("method")
  status   PaymentsStatus @default(PENDING)
  amount   Decimal        @db.Decimal(12, 2)
  currency String         @default("KZT")

  kaspiOrderId   String? @map("kaspi_order_id") // ID заказа на стороне Kaspi
  kaspiPaymentId String? @map("kaspi_payment_id") // ID транзакции Kaspi
  kaspiQrToken   String? @map("kaspi_qr_token") // QR-токен для оплаты

  halykInvoiceId    String? @map("halyk_invoice_id") // invoiceId из Halyk
  halykOrderId      String? @map("halyk_order_id") // orderId из Halyk
  halykTerminalId   String? @map("halyk_terminal_id") // terminal, с которого прошла оплата
  halykRrn          String? @map("halyk_rrn") // Reference Retrieval Number
  halykApprovalCode String? @map("halyk_approval_code")

  paidAt    DateTime? @map("paid_at")
  expiresAt DateTime? @map("expires_at")

  rawResponse Json? @map("raw_response") // сырой ответ от шлюза для дебага

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([kaspiOrderId])
  @@index([halykInvoiceId])
  @@map("payments")
}

// ─── ОТЗЫВЫ ──────────────────────────────────────────────────────────────────

model Review {
  id        String  @id @default(uuid())
  userId    String  @map("user_id")
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating     Int // 1-5
  title      String?
  text       String?
  isVerified Boolean @default(false) @map("is_verified") // купил товар

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

// ─── АДРЕСА ПОЛЬЗОВАТЕЛЕЙ ─────────────────────────────────────────────────────

model UserAddress {
  id     String @id @default(uuid())
  userId String @map("user_id")

  fullName   String  @map("full_name")
  phone      String
  city       String
  street     String
  building   String
  apartment  String?
  postalCode String? @map("postal_code")
  isDefault  Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_addresses")
}

// ─── ВАРИАНТЫ ТОВАРА (SKU) ────────────────────────────────────────────────────

model ProductVariant {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String   @unique
  name       String // e.g. "Красный / XL"
  price      Decimal? @db.Decimal(12, 2) // null = use product price
  stock      Int      @default(0)
  attributes Json? // { "color": "red", "size": "XL" }
  isActive   Boolean  @default(true) @map("is_active")

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

// ─── ФИЛИАЛЫ (самовывоз) ──────────────────────────────────────────────────────

model Branch {
  id           String  @id @default(uuid())
  name         String
  address      String
  city         String
  phone        String
  workingHours String? @map("working_hours") // "Пн-Пт 9:00-18:00"
  latitude     Float?
  longitude    Float?
  isActive     Boolean @default(true) @map("is_active")

  shippingAddresses ShippingAddress[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

// ─── НОВОСТНАЯ ЛЕНТА ──────────────────────────────────────────────────────────

model Notifications {
  id String @id @default(uuid())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @map("user_id")

  type    NotificationsType
  message String
  isRead  Boolean           @default(false) @map("is_read")

  actorId   String? @map("actor_id")
  projectId String? @map("project_id")
  albumId   String? @map("album_id")
  commentId String? @map("comment_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model DeviceToken {
  id String @id @default(uuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  token String @unique

  deviceType String @map("device_type")
  deviceName String @map("device_name")

  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, deviceType])
  @@map("device_tokens")
}

model NotificationsSettings {
  id String @id @default(uuid())

  siteNotifications Boolean @default(true) @map("site_notifications")
  pushNotifications Boolean @default(true) @map("push_notifications")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @unique @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notifications_settings")
}

model Token {
  id String @id @default(uuid())

  token     String
  type      TokenType
  expiresIn DateTime  @map("expires_in")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?   @map("user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tokens")
}

// ─── ПРОГРАММА ЛОЯЛЬНОСТИ ────────────────────────────────────────────────────

model LoyaltyCard {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique @map("user_id")

  totalOrders Int @default(0) @map("total_orders") // кол-во завершённых заказов
  discountPct Int @default(0) @map("discount_pct") // 0, 2, 3 или 5

  qrToken String @unique @map("qr_token") // токен для QR-кода на кассе

  accrualOperations LoyaltyAccrualOperation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("loyalty_cards")
}

model LoyaltyAccrualOperation {
  id String @id @default(uuid())

  operationId String @unique @map("operation_id") // внешний id оплаты/чека от кассы

  loyaltyCard   LoyaltyCard @relation(fields: [loyaltyCardId], references: [id], onDelete: Cascade)
  loyaltyCardId String      @map("loyalty_card_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([loyaltyCardId])
  @@map("loyalty_accrual_operations")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  DEACTIVATE_ACCOUNT
}

enum Role {
  USER
  MANAGER
  ADMIN
}

enum ArticleMediaType {
  IMAGE
  VIDEO
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationsType {
  ENABLE_TWO_FACTOR
  DISABLE_TWO_FACTOR
  ORDER_PLACED
  ORDER_PAID
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_REFUNDED
  ORDER_STATUS_CHANGED
  POST_COMMENT
  NEW_POST
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum PaymentsStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  EXPIRED
}

enum OrderStatus {
  PROCESSING
  ASSEMBLING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DeliveryType {
  COURIER
  PICKUP
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentMethod {
  KASPI_PAY
  HALYK_EKVAYRING
  CASH_ON_DELIVERY
}

enum DiscountType {
  PERCENT
  FIXED
}
