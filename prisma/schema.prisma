generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid())
  username              String                 @unique
  email                 String                 @unique
  pendingNewEmail       String?                @map("pending_new_email")
  password              String
  isVerified            Boolean                @default(false) @map("is_verified")
  isEmailVerified       Boolean                @default(false) @map("is_email_verified")
  isTotpEnabled         Boolean                @default(false) @map("is_totp_enabled")
  totpSecret            String?                @map("totp_secret")
  isDeactivated         Boolean                @default(false) @map("is_deactivated")
  deactivatedAt         DateTime?              @map("deactivated_at")
  phoneNumber           String?                @unique @map("phone_number")
  role                  Role                   @default(USER)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  accounts              Account[]
  articleComments       ArticleComment[]
  fcmTokens             DeviceToken[]
  loyaltyCard           LoyaltyCard?
  notifications         Notifications[]
  notificationsSettings NotificationsSettings?
  tokens                Token[]

  @@map("users")
}

model Account {
  id         String   @id @default(uuid())
  provider   String
  providerId String   @map("provider_id")
  userId     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("accounts")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String
  description String?
  imageUrl    String?    @map("image_url")
  parentId    String?    @map("parent_id")
  rostaId     String?    @unique @map("rosta_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  parent      Category?  @relation("category_tree", fields: [parentId], references: [id])
  children    Category[] @relation("category_tree")
  products    Product[]

  @@map("categories")
}

model Product {
  id              String           @id @default(uuid())
  name            String?
  description     String?
  price           Decimal?         @db.Decimal(12, 2)
  stock           Int              @default(0)
  isPublished     Boolean          @default(false) @map("is_published")
  isDraft         Boolean          @default(true) @map("is_draft")
  categoryId      String?          @map("category_id")
  attributes      Json?
  discountPercent Int?             @default(0) @map("discount_percent")
  avgRating       Float            @default(0) @map("avg_rating")
  reviewCount     Int              @default(0) @map("review_count")
  rostaId         String?          @unique @map("rosta_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  cartItems       CartItem[]
  medias          Media[]
  orderItems      OrderItem[]
  variants        ProductVariant[]
  category        Category?        @relation(fields: [categoryId], references: [id])
  reviews         Review[]

  @@index([categoryId])
  @@index([isPublished])
  @@map("products")
}

model Post {
  id          String           @id @default(uuid())
  title       String
  slug        String           @unique
  excerpt     String?
  body        String
  coverImage  String?          @map("cover_image")
  isPublished Boolean          @default(false) @map("is_published")
  publishedAt DateTime?        @map("published_at")
  tags        String[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  comments    ArticleComment[]

  @@index([isPublished])
  @@map("posts")
}

model ArticleComment {
  id        String   @id @default(uuid())
  body      String
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("article_comments")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id         String          @id @default(uuid())
  cartId     String          @map("cart_id")
  productId  String          @map("product_id")
  quantity   Int             @default(1)
  isSelected Boolean         @default(true) @map("is_selected")
  variantId  String?         @map("variant_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  cart       Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model Order {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  status         OrderStatus      @default(PROCESSING)
  totalAmount    Decimal          @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal?         @map("discount_amount") @db.Decimal(12, 2)
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  items          OrderItem[]
  payment        Payment?
  shipping       ShippingAddress?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(uuid())
  orderId      String          @map("order_id")
  productId    String          @map("product_id")
  variantId    String?         @map("variant_id")
  variantName  String?         @map("variant_name")
  quantity     Int
  priceAtOrder Decimal         @map("price_at_order") @db.Decimal(12, 2)
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  variant      ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model ShippingAddress {
  id           String       @id @default(uuid())
  orderId      String       @unique @map("order_id")
  fullName     String       @map("full_name")
  phone        String
  city         String
  street       String
  building     String
  apartment    String?
  postalCode   String?      @map("postal_code")
  deliveryType DeliveryType @default(COURIER) @map("delivery_type")
  branchId     String?      @map("branch_id")
  branch       Branch?      @relation(fields: [branchId], references: [id])
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("shipping_addresses")
}

model Media {
  id        String    @id @default(uuid())
  url       String
  mediaType MediaType @default(IMAGE)
  productId String    @map("product_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("medias")
}

model Payment {
  id                String         @id @default(uuid())
  orderId           String         @unique @map("order_id")
  method            PaymentMethod  @map("method")
  status            PaymentsStatus @default(PENDING)
  amount            Decimal        @db.Decimal(12, 2)
  currency          String         @default("KZT")
  kaspiOrderId      String?        @map("kaspi_order_id")
  kaspiPaymentId    String?        @map("kaspi_payment_id")
  kaspiQrToken      String?        @map("kaspi_qr_token")
  halykInvoiceId    String?        @map("halyk_invoice_id")
  halykOrderId      String?        @map("halyk_order_id")
  halykTerminalId   String?        @map("halyk_terminal_id")
  halykRrn          String?        @map("halyk_rrn")
  halykApprovalCode String?        @map("halyk_approval_code")
  paidAt            DateTime?      @map("paid_at")
  expiresAt         DateTime?      @map("expires_at")
  rawResponse       Json?          @map("raw_response")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([kaspiOrderId])
  @@index([halykInvoiceId])
  @@map("payments")
}

model Review {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  productId  String   @map("product_id")
  rating     Int
  title      String?
  text       String?
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("reviews")
}

model UserAddress {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  fullName   String   @map("full_name")
  phone      String
  city       String
  street     String
  building   String
  apartment  String?
  postalCode String?  @map("postal_code")
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_addresses")
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String      @map("product_id")
  sku        String      @unique
  name       String
  price      Decimal?    @db.Decimal(12, 2)
  stock      Int         @default(0)
  attributes Json?
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model Branch {
  id                String            @id @default(uuid())
  name              String
  address           String
  city              String
  phone             String
  workingHours      String?           @map("working_hours")
  latitude          Float?
  longitude         Float?
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  shippingAddresses ShippingAddress[]

  @@map("branches")
}

model Notifications {
  id        String            @id @default(uuid())
  userId    String?           @map("user_id")
  type      NotificationsType
  message   String
  isRead    Boolean           @default(false) @map("is_read")
  actorId   String?           @map("actor_id")
  projectId String?           @map("project_id")
  albumId   String?           @map("album_id")
  commentId String?           @map("comment_id")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  deviceType String   @map("device_type")
  deviceName String   @map("device_name")
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, deviceType])
  @@map("device_tokens")
}

model NotificationsSettings {
  id                String   @id @default(uuid())
  siteNotifications Boolean  @default(true) @map("site_notifications")
  pushNotifications Boolean  @default(true) @map("push_notifications")
  userId            String?  @unique @map("user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications_settings")
}

model Token {
  id        String    @id @default(uuid())
  token     String
  type      TokenType
  expiresIn DateTime  @map("expires_in")
  userId    String?   @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model LoyaltyCard {
  id                String                    @id @default(uuid())
  userId            String                    @unique @map("user_id")
  totalOrders       Int                       @default(0) @map("total_orders")
  discountPct       Int                       @default(0) @map("discount_pct")
  qrToken           String                    @unique @map("qr_token")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  accrualOperations LoyaltyAccrualOperation[]
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("loyalty_cards")
}

model LoyaltyAccrualOperation {
  id            String      @id @default(uuid())
  operationId   String      @unique @map("operation_id")
  loyaltyCardId String      @map("loyalty_card_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  loyaltyCard   LoyaltyCard @relation(fields: [loyaltyCardId], references: [id], onDelete: Cascade)

  @@index([loyaltyCardId])
  @@map("loyalty_accrual_operations")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  DEACTIVATE_ACCOUNT
}

enum Role {
  USER
  MANAGER
  ADMIN
}

enum ArticleMediaType {
  IMAGE
  VIDEO
}

enum MediaType {
  IMAGE
  VIDEO
}

enum NotificationsType {
  ENABLE_TWO_FACTOR
  DISABLE_TWO_FACTOR
  ORDER_PLACED
  ORDER_PAID
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  ORDER_REFUNDED
  ORDER_STATUS_CHANGED
  POST_COMMENT
  NEW_POST
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

enum PaymentsStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  EXPIRED
}

enum OrderStatus {
  PROCESSING
  ASSEMBLING
  READY_FOR_PICKUP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum DeliveryType {
  COURIER
  PICKUP
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentMethod {
  KASPI_PAY
  HALYK_EKVAYRING
  CASH_ON_DELIVERY
}

enum DiscountType {
  PERCENT
  FIXED
}
